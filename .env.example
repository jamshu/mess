# Required. Private — server-side only. NEVER prefix with PUBLIC_ (that leaks
# them into the client bundle). Read via $env/dynamic/private in server routes.
#
# ODOO_USERNAME / ODOO_API_KEY are the ADMIN account used at signup to create a
# new company + user, and for admin-key reads (org member lists, comment media).
# This user must be an Odoo administrator. Each user's own session is used for
# their own expense/group/settlement records so record rules isolate tenants.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=admin-username
ODOO_API_KEY=admin-api-key
# The expense model name — provisioned by `npm run setup:odoo`.
ODOO_MODEL=x_expense

# Web push (optional; generate once: npx web-push generate-vapid-keys)
# PUBLIC_VAPID_PUBLIC_KEY is safe to expose; the private key is server-only.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
